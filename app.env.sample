# CapRover app environment
# Copy to app.env and fill in your values

# Timezone
TZ=America/New_York

# Hostname / domain
BASE_HOST_NAME=caprover.example.com
BASE_DOMAIN_NAME=example.com

# CapRover settings
CAPROVER_ACCEPTED_TERMS=true

# Optional: set to the host's public IP when it cannot be auto-detected
CAPROVER_MAIN_NODE_IP=
